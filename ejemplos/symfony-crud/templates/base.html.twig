<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Tareas{% endblock %}</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <a href="{{ path('task_index') }}">Tareas</a>
        <a href="{{ path('task_new') }}">Nueva</a>
    </header>
    <main>
        {% for message in app.flashes('success') %}
            <p class="flash">{{ message }}</p>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</body>
</html>
