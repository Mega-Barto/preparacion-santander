{
    "name": "prep/task-api",
    "description": "API REST de tareas. La consumen frontend-vue y frontend-react.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^2.19",
        "nelmio/cors-bundle": "^2.4",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/framework-bundle": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/serializer": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/yaml": "6.4.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public"
    }
}
